{
  "name": "@socratescode/gateway",
  "version": "0.2.0",
  "private": true,
  "overrides": { "multer": "2.3.0", "deepmerge-ts": "8.0.0", "mysql2": "3.24.0" },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/main.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/gateway/src/main.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy",
    "test": "node --env-file-if-exists=.env --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "better-auth": "1.7.4",
    "express": "5.2.1",
    "graphql": "16.11.0",
    "nodemailer": "10.0.9",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.10.1",
    "@types/nodemailer": "8.0.1",
    "@types/pg": "8.15.6",
    "prisma": "7.10.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
