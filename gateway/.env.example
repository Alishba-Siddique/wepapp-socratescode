# Local development only. Use managed secrets and a separate database in production.
DATABASE_URL=postgresql://socratescode:socratescode_local@127.0.0.1:54329/socratescode
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3001
APP_ORIGIN=http://localhost:3001
PORT=4000
HOST=127.0.0.1
NODE_ENV=development
# Development mail is captured locally by Mailpit. No external mail is sent.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=socratescode <accounts@localhost.test>
# Production requires SMTP credentials and verified email before sign-in.
